# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # SECRET — server only, never expose

# Public base URL, used to build share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://rams.heliaxis.co.uk

# Address lookup — getAddress.io (PAF-licensed). Server-side only.
# Without it the address fields still work as plain text.
GETADDRESS_API_KEY=

# what3words — derives the site's three-word address from its coordinates.
# Without it the what3words field stays manual.
W3W_API_KEY=
