# Copy to .env.local and fill in. Never commit the filled copy.
#
# READ THIS FIRST: there are TWO Supabase projects in play and they use
# confusingly similar variable names. The three NEXT_PUBLIC_/SUPABASE_ variables
# below belong to THIS site's own project (profiles, enquiries, cms_kv,
# feedback). The two RAMS_ variables belong to a DIFFERENT project — the RAMS
# compliance platform at rams.heliaxis.co.uk. Pasting one project's values under
# the other's names does not fail loudly on its own: it writes a subcontractor
# application into a database with no table to hold it, or lets this site act on
# the compliance platform. createRamsClient() refuses to run when the two URLs
# are equal, which catches the most likely copy-and-paste of the two.

# ---------------------------------------------------------------------------
# This site's Supabase project (marketing site, CMS, enquiries, admin login).
# Project Settings -> API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The RAMS project — a SEPARATE Supabase project. Used only by the
# subcontractor portal at subcontract.heliaxis.co.uk, which writes an
# application into public.subcontractors and uploads its certificates to the
# private 'subcontractor-docs' bucket.
#
# Neither of these may ever carry a NEXT_PUBLIC_ prefix. NEXT_PUBLIC_ values are
# inlined into the browser bundle, the portal only talks to RAMS from the
# server, and next.config.ts already reads NEXT_PUBLIC_SUPABASE_URL to build its
# image host allowlist — so the RAMS URL must not travel under that name either.
#
# The service-role key bypasses RLS across the whole RAMS database: every
# project, document and signature. Holding it here widens its blast radius to
# this deployment, so treat it as a RAMS credential, never log it, and rotate it
# if this site is ever compromised.
# ---------------------------------------------------------------------------
RAMS_SUPABASE_URL=https://yyyyyyyyyyyyyyyy.supabase.co
RAMS_SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, the notification email links straight to the new firm's
# record instead of leaving the office to search for it.
RAMS_APP_URL=https://rams.heliaxis.co.uk

# ---------------------------------------------------------------------------
# Email (Resend). getResendApiKey() accepts any of the three spellings below;
# Heliaxis_Resend_API_Key is the one in use.
# ---------------------------------------------------------------------------
Heliaxis_Resend_API_Key=
# Where subcontractor applications and enquiry notifications are sent.
# Defaults to hello@heliaxis.co.uk when unset.
ADMIN_EMAIL=hello@heliaxis.co.uk
