# ── Supabase (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── AI provider (OpenAI-compatible; OpenRouter by default) ─────
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC. Never commit the real value.
# Reuses the same vars as the Heliaxis blog CMS, so on Vercel these are
# already set project-wide and inherited — nothing to add there.
OPENROUTER_API_KEY=sk-or-your-key
# Optional overrides (sensible defaults applied if unset):
# OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# ── Admin / user management ────────────────────────────────────
# SERVER-SIDE ONLY. The service-role key can manage auth users — never
# prefix with NEXT_PUBLIC and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Who can view/delete users in the studio (comma-separated, case-insensitive).
# Falls back to ADMIN_EMAIL if unset.
POST_STUDIO_ADMIN_EMAILS=callum@heliaxis.co.uk
